<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IsaacPickAndBan.ViewModels"
             xmlns:view="clr-namespace:IsaacPickAndBan.Views"
             xmlns:model="clr-namespace:IsaacPickAndBan.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fonts="clr-namespace:IsaacPickAndBan.FontAwesome"
             x:DataType="vm:MainViewModel"
             x:Class="IsaacPickAndBan.MainPage">

    <ContentPage.Resources>
        <x:Double x:Key="CardWidth" />
    </ContentPage.Resources>

    <Grid>
        <!--BACKGROUND-->
        <Image Source="background.jpg"
               Aspect="AspectFill" />
        <Rectangle Fill="Black"
                   Opacity="0.3" />

        
        <!--CONTENT CONTROL-->
        <ContentView Content="{Binding ActiveContentView}"/>


        <!--MENU-->
        <Grid ColumnDefinitions="*,*"
              HeightRequest="60"
              VerticalOptions="End">
            <Rectangle Grid.ColumnSpan="2"
                       Scale="1.05"
                       Fill="black"
                       Opacity="0.9" />
            <Button Text="Home"
                    HeightRequest="50"
                    WidthRequest="150" />
            <!--<Button Grid.Column="1"
         FontSize="24"
         Text="Pick &amp; Ban"
         HeightRequest="50"
         WidthRequest="150"/>-->
        </Grid>
    </Grid>

</ContentPage>
